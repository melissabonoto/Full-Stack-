<!DOCTYPE html>
<html>

<head>
    <title>Blog</title>
    <meta charset = "utf-8">
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <a href="/cadastrar_post.html"> <button id="button"> Criar Post</button> </a>
    
    <% for(var i = 0; i < posts.length; i++){ %>
        <div id="posts">
            <div id="post">
                <h2> <%= posts[i].titulo %> </h2>
                <p> <%= posts[i].resumo %> </p>
                <p> <%= posts[i].conteudo %> </p>
            </div>
        </div>

    <% } %>
</body>

</html>